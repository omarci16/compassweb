# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Apify
APIFY_API_TOKEN=apify_api_...

# Google PageSpeed Insights (site verification — Lead Scraping 2.0).
# Optional: PSI works without a key at low volume; a key raises the quota
# (free, 25k req/day). https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=

# Resend
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=info@compassmarketing.hu
# Where replies land. Cold outreach sends from a separate warmed domain that has
# no mailbox behind it — without this, a prospect who hits Reply gets a bounce
# and we never learn they were interested. Point it at a monitored inbox.
REPLY_TO_EMAIL=info@compassmarketing.hu
# Resend webhook signing secret (Scraping 2.1). REQUIRED for /api/webhooks/resend
# to accept open/bounce/complaint events. Resend Dashboard → Webhooks → your
# endpoint → "Signing Secret" (starts with whsec_). Without it the webhook 503s.
RESEND_WEBHOOK_SECRET=

# --- Scraping 2.1: cold outreach sending ---
# Separate sending DOMAIN inboxes to rotate cold email across (protects the main
# domain's reputation). Comma-separated `address[:From Name]`. If left empty, the
# app uses the sending_inboxes table, then falls back to RESEND_FROM_EMAIL.
SENDING_INBOXES=
# Per-inbox daily send cap (before warmup ramp). Default 30.
SENDING_DAILY_CAP=30
# Optional: secret used to sign one-click unsubscribe tokens. Falls back to
# INNGEST_SIGNING_KEY if unset. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
UNSUBSCRIBE_SECRET=

# Meta Ad Library API token (Scraping 2.1, OPTIONAL buying signal). Without it,
# ads detection simply no-ops — nothing breaks. Get one at
# https://www.facebook.com/ads/library/api (a long-lived user access token).
META_AD_LIBRARY_TOKEN=

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORTAL_BASE_URL=http://localhost:3000

# Inbound webhook
# Shared secret required in X-Webhook-Secret header on POST /api/leads/inbound.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=
